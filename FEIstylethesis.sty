\BeforeBeginEnvironment{document}{\FEIinternalSetup}
\def\FEIinternalSetup{
  \hypersetup{pdfinfo={
      Title={\FEItitle},
      Author={\FEIauthor},
      % Subject={\typPrace},
      Keywords={\FEIkeywords}
    }}
  \AtBeginDocument{
    \FEIcover
    \FEItitlePage
    \IfEq{\FEIassignmentPath}
    {}
    {
      \PackageWarningNoLine{FEIstylethesis}{Missing
        assignment in \string\FEIsetup. Assignment won't be typeset}
    }{
      \includepdf[pages=-]{\FEIassignmentPath}
    }
    \IfEq{\FEIacknowledgementsPath}{}{\PackageWarningNoLine{FEIstylethesis}{Missing
        acknowledgements in \string\FEIsetup. Acknowledgements won't be typeset}}{
      \FEIacknowledgements{\FEIacknowledgementsPath}}
    \IfEq{\FEIabstractPath}{}{\PackageWarningNoLine{FEIstylethesis}{Missing
        abstract in \string\FEIsetup. Abstract won't be typeset}}{
      \FEIabstract{\FEIabstractPath}}
    \IfEq{\FEIabstractEnPath}{}{\PackageWarningNoLine{FEIstylethesis}{Missing
        abstractEn in \string\FEIsetup. English version of abstract won't be typeset}}{
      \FEIabstractEn{\FEIabstractEnPath}}
    \FEItoc
  }
}

