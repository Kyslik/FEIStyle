% Slovak babel uses 'Obr.' as figure name, but 'Tabuľka' for table name. This
% definition fixes the inconsistency.
\AtBeginDocument{%
  \ifcsname captionsslovak\endcsname
    \expandafter\addto\csname captionsslovak\endcsname{%
      \renewcommand{\figurename}{Obrázok}%
      \renewcommand{\bibname}{Literatúra}%
    }%
  \fi

  % Localizaton of list of algorithms and listings
  \renewcommand{\listalgorithmname}{\fontsize{20pt}{1.3}\selectfont \FEIlistOfAlgorithmsString}
  \renewcommand{\lstlistlistingname}{\fontsize{20pt}{1.3}\selectfont \FEIlistOfListingsString}
  \renewcommand{\lstlistingname}{\FEIlistingString}
}

\def\FEIheaderSize{14.5pt}
\def\FEIsideMarginSize{2.75cm}

\newcommand\FEIcover{
  \pagestyle{empty}
  \newgeometry{tmargin=2cm,bmargin=1.8cm,lmargin=\FEIsideMarginSize,rmargin=\FEIsideMarginSize}
  \begin{sffamily}
    \begin{center}
      {\fontsize{\FEIheaderSize}{0}\selectfont\bfseries \MakeTextUppercase{\FEIuniversity}\\[11.3pt] \FEIfaculty}
    \end{center}
    \vspace{11.5mm}
    % \ifthenelse{\boolean{isThesis}}
    % {
      \fontsize{12.5pt}{0}\selectfont\noindent\FEIregNrString
    % }{}
    \vspace{51.5mm}
    \begin{center}
      {\fontsize{20.5pt}{18.2pt}\selectfont\bfseries\nointerlineskip\FEItitleString\par}\vspace{29pt}
      {\fontsize{\FEIheaderSize}{0}\selectfont\bfseries \FEIthesisTypeString}
    \end{center}
    \vspace{\fill}
    \begin{flushleft}
      {\fontsize{\FEIheaderSize}{0}\selectfont\bfseries
        \FEIyear
        \hfill
        \FEIauthor}
    \end{flushleft}
  \end{sffamily}
  \restoregeometry
  \newpage    
}

\newcommand\FEItitlePage{
  \setcounter{page}{1}
  \pagestyle{empty}
  \newgeometry{tmargin=3.024cm,bmargin=2.775cm,lmargin=\FEIsideMarginSize,rmargin=\FEIsideMarginSize}
  \begin{sffamily}
    \begin{center}
      {\fontsize{14pt}{1.3}\selectfont \bfseries \MakeTextUppercase{\FEIuniversity}\\[9.4pt] \FEIfaculty}
    \end{center}
    \vspace{9mm}
    {
      % \ifthenelse{\boolean{isThesis}}
      % {
        \fontsize{12pt}{1.3}\selectfont \FEIregNrString
      % }{}
    }
    \vspace{40.9mm}
    \begin{center}
      {\fontsize{20pt}{18.1pt}\selectfont\bfseries\FEItitleString\par}\vspace{22pt}
      {\fontsize{14pt}{0}\selectfont\bfseries\FEIthesisTypeString}
    \end{center}
    \vspace{\fill}
    {\fontsize{12pt}{14pt}\selectfont
      \begin{tabbing}
        \hspace*{5cm}\= \kill
        \FEIstudyProgrString \> \FEIstudyProgrammeName \\
        % \ifthenelse{\boolean{isThesis}}
        % {
          \FEIstudyFieldString{} \> \FEIstudyFieldName{} \\
          \FEItrainWorkpString \> \FEItrainingWorkplaceName \\
          \FEIsupervisorString \> \FEIsupervisor \\
          \IfEq{\FEIconsultant}{}{}{\FEIconsultantString \> \FEIconsultant
          \IfEq{\FEIconsultant}{\FEIsupervisor}{\PackageWarningNoLine{FEIstylethesis}{Consultant
              shouldn't be the same person as the supervisor. You should probably
              remove consultant from \string\FEIsetup}}{}}
        % }
  %       % {\@tempCourse \> \parbox[t]{9cm}{\@skolaCourse\vspace{1ex}} \\ %TODO use this for abstract minipage
  %       %   \@tempLecturer \> \@skolaLecturer \\
  %       %   \@tempTa \> \@skolaTa \\
  %       % }
      \end{tabbing}
    }
    \vspace{3.43cm}
    \begin{flushleft}
      {\fontsize{12pt}{0}\selectfont \bfseries
        \FEIyear
        \hfill
        \FEIauthor}
    \end{flushleft}
  \end{sffamily}
  \restoregeometry
  \newpage
}

\newcommand\FEIacknowledgements[1]{
  \pagestyle{empty}
  \vspace*{\stretch{1}}
  \section*{\fontsize{16pt}{1.3}\selectfont \FEIacknowledgementsString}
  \vspace{1pt}
  \input{#1}
  \vspace{7.1pt}
  \newpage
}

\newcommand\FEIabstractGeneric[4]{
  \pagestyle{empty}   
  \vspace*{-26.6pt}
  \section*{\fontsize{20pt}{1.3}\selectfont #2}
  \vspace{0.45cm}
  
  \noindent\input{#1}
  
  \vspace{0.8cm}
  \noindent \textbf{#3}
  
  \vspace{0.3cm}
  \noindent #4
  \clearpage
}
    
\newcommand\FEIabstractEn[1]{
  \FEIabstractGeneric{#1}{\FEIabstractString}{\FEIkeywordsString}{\FEITeXkeywordsEn}
}

\newcommand\FEIabstract[1]{
  \FEIabstractGeneric{#1}{\FEIabstractString}{\FEIkeywordsString}{\FEITeXkeywords}
}

\newcommand\FEItoc{ 
  \pagestyle{plain}
  %\addtocontents{toc}{\protect\thispagestyle{plain}}
  \tableofcontents
  \newpage
}

\newcommand\FEIlistOfFiguresAndTables{ 
  % \pagestyle{plain}

  \renewcommand{\cftfigpresnum}{\figurename~}
  \renewcommand{\cfttabpresnum}{\tablename~}
  \newlength{\mylenf}
  \settowidth{\mylenf}{\cftfigpresnum}
  \setlength{\cftfignumwidth}{\dimexpr\mylenf+3em}
  \setlength{\cfttabnumwidth}{\dimexpr\mylenf+3em}
  
  \section*{\fontsize{20pt}{1.3}\selectfont \FEIlistOfFiguresAndTablesString}
  \phantomsection
  \@starttoc{lof}
  \bigskip
  \@starttoc{lot}
  \newpage
  %\pagestyle{plain}
}

\newcommand\FEIintroduction[1]{
  % \pagestyle{plain}
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{chapter}{\FEIintroductionString}
  \section*{\FEIintroductionString}
  \noindent \input{#1}
}

\newcommand\FEIconclusion[1]{
  \newpage
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{chapter}{\FEIconclusionString}
  \section*{\FEIconclusionString}
  \noindent \input{#1}
}

\newcommand\FEIresume[1]{
  \newpage
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{chapter}{\FEIresumeString}
  \section*{\FEIresumeString}
  \noindent \input{#1}
}

\newcommand\FEIaiDeclaration[1]{
  \phantomsection
  \addcontentsline{toc}{section}{\FEIaiDeclarationString}
  \section*{\FEIaiDeclarationString}
  \input{#1}\par
}

\AddToHook{cmd/appendix/after}{%
  \renewcommand{\thechapter}{\appendixname{} \Alph{chapter}}%
  \def\@FEIafterTheChapter{:}
  \def\@FEIbeforeChapterName{\ }

  \addtocontents{toc}{%
    \protect\setlength{\protect\cftchapnumwidth}{6em}%
  }%
}

\newenvironment{changemargin}[2]
{%
  \begin{list}{}{%
      \setlength{\leftmargin}{#1}%
      \setlength{\rightmargin}{#2}%
    }%
  \item[]%
  }
  {%
  \end{list}%
