% FEIsetup metadata keyval settings
\long\def\FEIsetup#1{%
  \setkeys{FEIstyle}{#1}
  \FEIdefineStrings}
\define@key{FEIstyle}{language}{%
  \def\FEIlanguage{#1}}
\define@key{FEIstyle}{type}{%
  \IfEqCase*{#1}
  {
    {bp}{\def\FEIthesisType{#1}}
    {dp}{\def\FEIthesisType{#1}}
    {dizp}{\def\FEIthesisType{#1}}
  }
  [
  \PackageWarning{FEIstyle}{Incorrect thesis type.
    Suppoted values: bp, dp, dizp.}
  \def\FEIthesisType{bp}]}
\define@key{FEIstyle}{author}{%
  \def\FEIauthor{#1}}
\define@key{FEIstyle}{regnr}{%
  \def\FEIregNr{#1}}
\define@key{FEIstyle}{title}{%
  \def\FEItitle{#1}}
\define@key{FEIstyle}{TeXtitle}{%
  \def\FEITeXtitle{#1}}
\define@key{FEIstyle}{titleEn}{%
  \def\FEItitleEn{#1}}
\define@key{FEIstyle}{TeXtitleEn}{%
  \def\FEITeXtitleEn{#1}}
\define@key{FEIstyle}{year}{%
  \def\FEIyear{#1}}
\define@key{FEIstyle}{keywords}{%
  \def\FEIkeywords{#1}}
\define@key{FEIstyle}{TeXkeywords}{%
  \def\FEITeXkeywords{#1}}
\define@key{FEIstyle}{keywordsEn}{%
  \def\FEIkeywordsEn{#1}}
\define@key{FEIstyle}{TeXkeywordsEn}{%
  \def\FEITeXkeywordsEn{#1}}
\define@key{FEIstyle}{supervisor}{%
  \def\FEIsupervisor{#1}}
\define@key{FEIstyle}{consultant}{%
  \def\FEIconsultant{#1}}
\define@key{FEIstyle}{studyProgramme}{%
  \def\FEIstudyProgramme{#1}}
\define@key{FEIstyle}{studyProgrammeEn}{%
